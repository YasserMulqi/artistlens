---
import { useTranslations, localizedPath, type Lang } from '../i18n/ui';
import { SITE } from '../consts';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isEnglish = lang === 'en';
---

<header class="site-header">
  <a class="brand" href={localizedPath(lang, '/')} aria-label="ArtistLens home">
    {
      isEnglish ? (
        <img class="brand-figma" src="/images/figma/artistlens-logo.svg" alt="ArtistLens" />
      ) : (
        <>
          <span class="brand-artist">ARTIST</span><span class="brand-lens">LENS</span>
        </>
      )
    }
  </a>
  <nav>
    {
      isEnglish ? (
        <>
          <a href="/#projects">Projects</a>
          <a href="/#services">Services</a>
          <a class="nav-motion" href="/#motion">
            <span>Motion</span><span class="motion-play" aria-hidden="true"></span>
          </a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
          <a class="nav-cta" href="/#contact">Start a Project</a>
        </>
      ) : (
        <>
          <a href={localizedPath(lang, '/')}>{t('nav.home')}</a>
          <a href={localizedPath(lang, '/#work')}>{t('nav.projects')}</a>
        </>
      )
    }
    <LangSwitch lang={lang} />
  </nav>
</header>
