---
import MotionWord from './MotionWord.astro';
import { homepage } from '../data/homepage';
---

<div class="home-page" data-figma-frame="48:3">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img src={homepage.hero.image} alt="" />
    </div>

    <div class="home-hero__content">
      <div class="home-motion-kicker">
        <span>{homepage.hero.eyebrow}</span>
        <span class="motion-play" aria-hidden="true"></span>
      </div>
      <h1 id="home-hero-title">
        {homepage.hero.title.split('\n').map((line) => <span class="hero-title-line"><span>{line}</span></span>)}
      </h1>
      <p>{homepage.hero.summary}</p>
      <div class="home-actions">
        <a class="button button--primary" href="#contact">{homepage.hero.primaryCta}</a>
        <a class="button button--ghost" href="#projects">{homepage.hero.secondaryCta}</a>
      </div>
      <div class="home-tags" aria-label="Specialties">
        {
          homepage.hero.tags.map((tag) => (
            <span class="home-tag">{tag === 'Motion' ? <MotionWord /> : tag}</span>
          ))
        }
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true">
      <span></span>
      <strong>SCROLL TO EXPLORE</strong>
    </div>
  </section>

  <section id="projects" class="figma-section projects-section" aria-labelledby="projects-title">
    <div class="figma-section__heading projects-heading">
      <div>
        <p class="eyebrow">{homepage.projects.eyebrow}</p>
        <h2 id="projects-title">{homepage.projects.title}</h2>
      </div>
      <p class="section-cue">{homepage.projects.cue} <span>→</span></p>
    </div>

    <div class="projects-rail" aria-label="Selected projects">
      <div class="projects-track">
        {
          homepage.projects.items.map((project) => (
            <a class="project-tile" href={project.href}>
              <img src={project.image} alt="" loading="lazy" />
              <span class="project-tile__number">{project.number}</span>
              <div>
                <p>{project.category}</p>
                <h3>{project.title}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div class="rail-progress" aria-hidden="true">
      <span><i></i></span>
      <strong>{homepage.projects.counter}</strong>
    </div>
  </section>

  <section id="frames" class="figma-section frames-section" aria-labelledby="frames-title">
    <div class="figma-section__heading frames-heading">
      <div>
        <p class="eyebrow">{homepage.frames.eyebrow}</p>
        <h2 id="frames-title">{homepage.frames.title}</h2>
      </div>
      <p class="section-cue">{homepage.frames.cue} <span>↓</span></p>
    </div>

    <div class="frames-deck" aria-label="Selected frames">
      {
        homepage.frames.images.map((image) => (
          <div class="frame-layer">
            <div class="frame-plate">
              <img src={image} alt="" loading="lazy" />
              <span class="frame-top-shadow" aria-hidden="true"></span>
            </div>
          </div>
        ))
      }
      <div class="frames-meta">
        <div class="frame-dots" aria-hidden="true">
          <span class="is-active"></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="frames-caption">
          <strong>{homepage.frames.counter}</strong>
          <span></span>
          <p>{homepage.frames.caption}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="figma-section services-section" aria-labelledby="services-title">
    <div class="services-copy">
      <p class="eyebrow">{homepage.services.eyebrow}</p>
      <h2 id="services-title">{homepage.services.title}</h2>
      <p>{homepage.services.summary}</p>
    </div>

    <div class="service-grid">
      {
        homepage.services.items.map((service) => (
          <article class="service-card">
            <img src={service.image} alt="" loading="lazy" />
            {service.title === 'Motion' && (
              <span class="service-play" aria-hidden="true">
                <i></i>
              </span>
            )}
            <div>
              <header>
                <span>{service.number}</span>
                <b>→</b>
              </header>
              <h3>{service.title === 'Motion' ? <MotionWord /> : service.title}</h3>
              <p>{service.summary}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="motion" class="figma-section motion-section" aria-labelledby="motion-title">
    <div class="motion-heading">
      <div>
        <div class="home-motion-kicker">
          <span>{homepage.motion.eyebrow}</span>
          <span class="motion-play" aria-hidden="true"></span>
        </div>
        <h2 id="motion-title">
          <MotionWord /> {homepage.motion.titleSuffix}
        </h2>
      </div>
      <a href="#contact">{homepage.motion.cta}</a>
    </div>

    <div class="reel-block">
      <img src={homepage.motion.image} alt="" loading="lazy" />
      <span class="reel-play" aria-hidden="true"><i></i></span>
      <div class="reel-copy">
        <p>{homepage.motion.meta}</p>
        <h3>{homepage.motion.title}</h3>
      </div>
      <time>{homepage.motion.duration}</time>
    </div>
  </section>

  <section id="contact" class="figma-section contact-section" aria-labelledby="contact-title">
    <p class="eyebrow">{homepage.contact.eyebrow}</p>
    <h2 id="contact-title">{homepage.contact.title}</h2>
    <p>{homepage.contact.summary}</p>
    <div class="contact-actions">
      <a class="button button--primary" href={`mailto:${homepage.contact.email}`}>{homepage.contact.primaryCta}</a>
      <span><i></i>{homepage.contact.availability}</span>
    </div>
    <div class="contact-links">
      <a href={`mailto:${homepage.contact.email}`}>{homepage.contact.email}</a>
      {homepage.contact.links.map((item) => <><span></span><a href="#contact">{item}</a></>)}
    </div>
  </section>

  <section id="about" class="figma-section about-section" aria-labelledby="about-title">
    <img class="about-portrait" src={homepage.about.image} alt="Yasser Al-Mulqi" loading="lazy" />
    <div class="about-copy">
      <p class="eyebrow">{homepage.about.eyebrow}</p>
      <h2 id="about-title">{homepage.about.title}</h2>
      <p>{homepage.about.body}</p>
      <div class="about-stats">
        {
          homepage.about.stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>

<script>
  import '../scripts/homeMotion';
</script>
