---
import type { CollectionEntry } from 'astro:content';
import MotionWord from './MotionWord.astro';
import { homepage } from '../data/homepage';

type HomepageContent = typeof homepage;
type ProjectCard = {
  number?: string;
  category: string;
  title: string;
  href: string;
  image: string;
  imageAlt?: string;
};

type Props = {
  selectedProjects?: CollectionEntry<'projects'>[];
  selectedProjectCards?: ProjectCard[];
  content?: HomepageContent;
  lang?: 'en' | 'ar';
};

const {
  selectedProjects = [],
  selectedProjectCards: projectCards,
  content = homepage,
  lang = 'en',
} = Astro.props;
const isArabic = lang === 'ar';

const selectedProjectCards =
  projectCards ??
  selectedProjects.map((project, index) => ({
    number: String(index + 1).padStart(2, '0'),
    category: project.data.category ?? 'PROJECT',
    title: project.data.title,
    href: `/${isArabic ? 'ar/' : ''}projects/${project.data.slug}`,
    image: project.data.cover ?? '/images/home/project-product.webp',
  }));

const imageDescriptions: Record<'en' | 'ar', Record<string, string>> = {
  en: {
    '/images/home/hero-car.jpg': 'Cinematic automotive detail used as the ArtistLens homepage hero image',
    '/images/home/project-product.jpg': 'Reflective product photography with detailed jewelry texture',
    '/images/home/project-interior.jpg': 'Warm interior space photographed with cinematic light',
    '/images/home/project-food.jpg': 'Close-up food photography with rice and pastry texture',
    '/images/home/motion-vfx.jpg': 'Motion production still from a cinematic brand film scene',
  },
  ar: {
    '/images/home/hero-car.jpg': 'تفصيل سيارة بإضاءة سينمائية في واجهة ArtistLens',
    '/images/home/project-product.jpg': 'تصوير منتجات بتفاصيل عاكسة وملمس مجوهرات',
    '/images/home/project-interior.jpg': 'مساحة داخلية دافئة مصورة بإضاءة سينمائية',
    '/images/home/project-food.jpg': 'تصوير طعام قريب يبرز ملمس الأرز والعجين',
    '/images/home/motion-vfx.jpg': 'لقطة من إنتاج موشن لفيلم علامة تجارية',
  },
};
const imageLanguage = isArabic ? 'ar' : 'en';
const heroTitleLines = content.hero.title.split('\n');
const formatHeroTitleLine = (line: string, index: number) =>
  !isArabic && index === 1 ? line.replace(/\s*(?:\u2014|\u2013|-|\u00e2\u20ac\u201d)\s*$/, '') : line;
const formatMobileHeroTitleLine = (line: string, index: number) =>
  !isArabic && index === 1
    ? formatHeroTitleLine(line, index).replace(/\bspace\b/i, 's p a c e')
    : !isArabic && index === 2
      ? formatHeroTitleLine(line, index).replace(/\.$/, '')
      : formatHeroTitleLine(line, index);
const getImageAlt = (src: string, fallback: string) =>
  imageDescriptions[imageLanguage][src] ?? imageDescriptions[imageLanguage][src.replace(/\.webp$/, '.jpg')] ?? fallback;
const getProjectImageAlt = (project: ProjectCard) =>
  project.imageAlt ??
  (isArabic
    ? `صورة مشروع ${project.title} ضمن ${project.category}`
    : `${project.title} ${project.category} project image`);
---

<div class="home-page" data-figma-frame={isArabic ? '133:3' : '90:3'} data-home-lang={lang}>
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media">
      <img
        src={content.hero.image}
        alt={getImageAlt(content.hero.image, isArabic ? 'صورة رئيسية سينمائية من ArtistLens' : 'ArtistLens cinematic homepage hero image')}
      />
    </div>

    <div class="home-hero__content">
      <div class="home-motion-kicker">
        <span>{content.hero.eyebrow}</span>
        {!isArabic && <span class="motion-play" aria-hidden="true"></span>}
      </div>
      <h1 id="home-hero-title">
        {
          heroTitleLines.map((line, index) => (
            <span class="hero-title-line">
              <span class:list={[index === 1 && 'hero-title-space-line', index === 2 && 'hero-title-seen-line']}>
                {!isArabic && (index === 1 || index === 2) ? (
                  <>
                    <span class="hero-title-line-default">{formatHeroTitleLine(line, index)}</span>
                    <span class="hero-title-line-mobile">{formatMobileHeroTitleLine(line, index)}</span>
                  </>
                ) : (
                  formatHeroTitleLine(line, index)
                )}
                {!isArabic && index === 1 && <span class="hero-title-mobile-dash"> &mdash;</span>}
              </span>
            </span>
          ))
        }
      </h1>
      <p>{content.hero.summary}</p>
      <div class="home-actions">
        <a class="button button--primary" href="#contact">{content.hero.primaryCta}</a>
        <a class="button button--ghost" href="#projects">{content.hero.secondaryCta}</a>
      </div>
      <div class="home-tags" aria-label={isArabic ? 'التخصصات' : 'Specialties'}>
        {
          content.hero.tags.map((tag) => (
            <span class="home-tag">
              {!isArabic && tag === 'Motion' ? (
                <MotionWord />
              ) : isArabic && tag === 'موشن' ? (
                <span class="motion-word motion-word--ar motion-word--tag">
                  <span>{tag}</span>
                  <span class="motion-play" aria-hidden="true"></span>
                </span>
              ) : (
                tag
              )}
            </span>
          ))
        }
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true">
      <span></span>
      <strong>{content.hero.scrollCue}</strong>
    </div>
  </section>

  <section id="projects" class="figma-section projects-section" aria-labelledby="projects-title">
    <div class="figma-section__heading projects-heading">
      <div>
        <p class="eyebrow">{content.projects.eyebrow}</p>
        <h2 id="projects-title">{content.projects.title}</h2>
      </div>
      <p class="section-cue">{content.projects.cue} <span>{isArabic ? '←' : '→'}</span></p>
    </div>

    <div class="projects-rail" aria-label={content.projects.title}>
      <div class="projects-track">
        {
          selectedProjectCards.map((project, index) => (
            <a class="project-tile" href={project.href}>
              <img src={project.image} alt={getProjectImageAlt(project)} loading="lazy" />
              <span class="project-tile__number">{project.number ?? String(index + 1).padStart(2, '0')}</span>
              <div>
                <p>{project.category}</p>
                <h3>{project.title}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div class="rail-progress" aria-hidden="true">
      <span><i></i></span>
      <strong>{content.projects.counter}</strong>
    </div>
  </section>

  <section id="frames" class="figma-section frames-section" aria-labelledby="frames-title">
    <div class="figma-section__heading frames-heading">
      <div>
        <p class="eyebrow">{content.frames.eyebrow}</p>
        <h2 id="frames-title">{content.frames.title}</h2>
      </div>
      <p class="section-cue">{content.frames.cue} <span>↓</span></p>
    </div>

    <div class="frames-deck" aria-label={content.frames.title}>
      {
        content.frames.images.map((image, index) => (
          <div class="frame-layer">
            <span class="frame-top-shadow" aria-hidden="true"></span>
            <div class="frame-plate">
              <img
                src={image}
                alt={getImageAlt(
                  image,
                  isArabic ? `لقطة مختارة رقم ${index + 1} من ArtistLens` : `Selected ArtistLens frame ${index + 1}`
                )}
                loading="lazy"
              />
            </div>
          </div>
        ))
      }
      <div class="frames-meta">
        <div class="frame-dots" aria-hidden="true">
          <span class="is-active"></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="frames-caption">
          <strong>{content.frames.counter}</strong>
          <span></span>
          <p>{content.frames.caption}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="figma-section services-section" aria-labelledby="services-title">
    <div class="services-copy">
      <p class="eyebrow">{content.services.eyebrow}</p>
      <h2 id="services-title">{content.services.title}</h2>
      <p>{content.services.summary}</p>
    </div>

    <div class="service-grid">
      {
        content.services.items.map((service) => (
          <article class="service-card">
            <img
              src={service.image}
              alt={getImageAlt(
                service.image,
                isArabic ? `صورة خدمة ${service.title}` : `${service.title} service image`
              )}
              loading="lazy"
            />
            {(service.title === 'Motion' || service.title === 'موشن') && (
              <span class="service-play" aria-hidden="true">
                <i></i>
              </span>
            )}
            <div>
              <header>
                <span>{service.number}</span>
                <b>{isArabic ? '←' : '→'}</b>
              </header>
              <h3>
                {
                  !isArabic && service.title === 'Motion' ? (
                    <MotionWord />
                  ) : isArabic && service.title === 'موشن' ? (
                    <span class="motion-word motion-word--ar">
                      <span>{service.title}</span>
                      <span class="motion-play" aria-hidden="true"></span>
                    </span>
                  ) : (
                    service.title
                  )
                }
              </h3>
              <p>{service.summary}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="motion" class="figma-section motion-section" aria-labelledby="motion-title">
    <div class="motion-heading">
      <div>
        <div class="home-motion-kicker">
          {
            isArabic ? (
              <span class="motion-word motion-word--ar motion-word--kicker">
                <span>{content.motion.eyebrow}</span>
                <span class="motion-play" aria-hidden="true"></span>
              </span>
            ) : (
              <>
                <span>{content.motion.eyebrow}</span>
                <span class="motion-play" aria-hidden="true"></span>
              </>
            )
          }
        </div>
        <h2 id="motion-title">
          {
            isArabic ? (
              <>
                {content.motion.titleSuffix}{' '}
                <span class="motion-word motion-word--ar">
                  <span>{content.motion.titlePrefix}</span>
                  <span class="motion-play" aria-hidden="true"></span>
                </span>
              </>
            ) : (
              <MotionWord />
            )
          }{!isArabic && ` ${content.motion.titleSuffix}`}
        </h2>
      </div>
      <a href="#contact">{content.motion.cta}</a>
    </div>

    <div class="reel-block">
      <img
        src={content.motion.image}
        alt={getImageAlt(content.motion.image, isArabic ? 'لقطة من فيلم موشن من ArtistLens' : 'ArtistLens motion reel still')}
        loading="lazy"
      />
      <span class="reel-play" aria-hidden="true"><i></i></span>
      <div class="reel-copy">
        <p>{content.motion.meta}</p>
        <h3>{content.motion.title}</h3>
      </div>
      <time>{content.motion.duration}</time>
    </div>
  </section>

  <section id="about" class="figma-section about-section" aria-labelledby="about-title">
    <img class="about-portrait" src={content.about.image} alt={content.about.imageAlt} loading="lazy" />
    <div class="about-copy">
      <p class="eyebrow">{content.about.eyebrow}</p>
      <h2 id="about-title">{content.about.title}</h2>
      <p>{content.about.body}</p>
      <div class="about-stats">
        {
          content.about.stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="figma-section contact-section" aria-labelledby="contact-title">
    <p class="eyebrow">{content.contact.eyebrow}</p>
    <h2 id="contact-title">{content.contact.title}</h2>
    <p>{content.contact.summary}</p>
    <div class="contact-actions">
      <a class="button button--primary" href={`mailto:${content.contact.email}`}>{content.contact.primaryCta}</a>
      <span><i></i>{content.contact.availability}</span>
    </div>
    <div class="contact-links">
      <a href={`mailto:${content.contact.email}`}>{content.contact.email}</a>
      {content.contact.links.map((item) => <><span></span><a href="#contact">{item}</a></>)}
    </div>
  </section>

  <footer class="home-mobile-footer">
    <p>{content.footer}</p>
  </footer>

  <button class="back-to-top" type="button" aria-label={content.backToTopLabel}>{content.backToTop}</button>
</div>

<script>
  import '../scripts/homeMotion';
</script>
