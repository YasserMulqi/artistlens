---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const target: Lang = lang === 'ar' ? 'en' : 'ar';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const projectMatch = currentPath.match(/^\/(?:ar\/)?projects\/([^/]+)$/);
const href = projectMatch
  ? target === 'ar'
    ? `/ar/projects/${projectMatch[1]}`
    : `/projects/${projectMatch[1]}`
  : target === 'ar'
    ? '/ar'
    : '/';
---

<a class="lang-switch" href={href} hreflang={target} aria-label="Switch language">
  {languages[target]}
</a>
