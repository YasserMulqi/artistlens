---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Simple home-to-home toggle. A path-aware switch can be added later once
// deep project URLs need to map across locales.
const target: Lang = lang === 'ar' ? 'en' : 'ar';
const href = target === 'ar' ? '/ar' : '/';
---

<a class="lang-switch" href={href} hreflang={target} aria-label="Switch language">
  {languages[target]}
</a>
