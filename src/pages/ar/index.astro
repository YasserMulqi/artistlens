---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomepageDesktop from '../../components/HomepageDesktop.astro';
import { SITE } from '../../consts';
import { homepageAr } from '../../data/homepage';

const lang = 'ar';
const arabicTitles = [
  ['منتجات', 'حضور المنتج'],
  ['طعام', 'طعم بصري'],
  ['داخلي', 'مساحات هادئة'],
  ['موشن', 'حركة سينمائية'],
  ['منتجات', 'تفاصيل العلامة'],
  ['طعام', 'قائمة شهية'],
  ['داخلي', 'ضوء ومساحة'],
  ['موشن', 'ريل العلامة'],
  ['منتجات', 'لقطة بطولية'],
  ['طعام', 'ملمس ونكهة'],
  ['داخلي', 'عمق المكان'],
  ['موشن', 'إيقاع بصري'],
];

const sourceProjects = (await getCollection(
  'projects',
  (project) => project.data.language === 'en' && !project.data.draft
))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 12);

const arabicProjectSlugs = new Set(
  (await getCollection('projects', (project) => project.data.language === 'ar' && !project.data.draft)).map(
    (project) => project.data.slug
  )
);

const selectedProjectCards = sourceProjects.map((project, index) => ({
  number: String(index + 1).padStart(2, '0'),
  category: arabicTitles[index]?.[0] ?? 'مشروع',
  title: arabicTitles[index]?.[1] ?? project.data.title,
  href: arabicProjectSlugs.has(project.data.slug)
    ? `/ar/projects/${project.data.slug}`
    : `/projects/${project.data.slug}`,
  image: project.data.cover ?? '/images/home/project-product.webp',
}));
---

<BaseLayout
  title={`${SITE.name} - إنتاج بصري سينمائي`}
  description="ArtistLens صفحة رئيسية سينمائية للتصوير والموشن من ياسر المُلقي."
  lang={lang}
  bodyClass="home-page-shell home-desktop"
  canonicalPath="/ar/"
  ogImage="/images/home/hero-car.jpg"
>
  <HomepageDesktop content={homepageAr} lang={lang} selectedProjectCards={selectedProjectCards} />
</BaseLayout>
