---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageDesktop from '../components/HomepageDesktop.astro';
import { SITE } from '../consts';

const lang = 'en';
const selectedProjects = (await getCollection(
  'projects',
  (project) => project.data.language === 'en' && !project.data.draft
))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 12);
---

<BaseLayout
  title={`${SITE.name} - Cinematic Visual Production`}
  description="ArtistLens is a cinematic visual production portfolio by Yasser Al-Mulqi."
  lang={lang}
  bodyClass="home-page-shell home-desktop"
  canonicalPath="/"
  ogImage="/images/home/hero-car.jpg"
>
  <HomepageDesktop selectedProjects={selectedProjects} />
</BaseLayout>
